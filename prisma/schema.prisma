generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bayi (Dealer) Model
model Dealer {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  companyName   String
  contactName   String
  phone         String
  address       String?
  city          String?
  taxNumber     String?
  role          UserRole @default(DEALER)
  isApproved    Boolean  @default(false)
  isActive      Boolean  @default(true)
  priceTier     PriceTier @default(STANDARD)
  creditLimit   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]
  cart          Cart?
  quoteRequests QuoteRequest[]
  currentAccount CurrentAccount?
  notifications Notification[]
}

// Ürün Kategorileri
model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Ürünler (Sulama Ekipmanları)
model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Float
  stock       Int      @default(0)
  images      String[]
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  // Ürün özellikleri
  brand       String?
  model       String?
  material    String?
  diameter    String?
  pressure    String?
  flowRate    String?
  
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems           OrderItem[]
  cartItems            CartItem[]
  quoteRequestItems    QuoteRequestItem[]
  technicalSpecs       TechnicalSpecification[]
}

// Sipariş
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  dealerId        String
  dealer          Dealer      @relation(fields: [dealerId], references: [id])
  
  status          OrderStatus @default(PENDING)
  totalAmount     Float
  shippingAddress String
  notes           String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

// Sepet
model Cart {
  id        String     @id @default(cuid())
  dealerId  String     @unique
  dealer    Dealer     @relation(fields: [dealerId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PriceTier {
  STANDARD
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuoteStatus {
  PENDING
  REVIEWED
  QUOTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TransactionType {
  DEBIT
  CREDIT
  ORDER
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum NotificationType {
  ORDER_STATUS
  QUOTE_STATUS
  PAYMENT_DUE
  STOCK_ALERT
  PROMOTION
  SYSTEM
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_REP
  DEALER
  DEALER_EMPLOYEE
}

// Teklif İstekleri (Quote Requests)
model QuoteRequest {
  id              String        @id @default(cuid())
  quoteNumber     String        @unique
  dealerId        String
  dealer          Dealer        @relation(fields: [dealerId], references: [id])

  status          QuoteStatus   @default(PENDING)
  totalAmount     Float?
  discountPercent Float?
  finalAmount     Float?
  validUntil      DateTime?
  shippingAddress String
  notes           String?
  adminNotes      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewedAt      DateTime?
  quotedAt        DateTime?

  items           QuoteRequestItem[]
}

model QuoteRequestItem {
  id             String       @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  requestedPrice Float?
  quotedPrice    Float?
  notes          String?
}

// Cari Hesap (Current Account)
model CurrentAccount {
  id           String                    @id @default(cuid())
  dealerId     String                    @unique
  dealer       Dealer                    @relation(fields: [dealerId], references: [id])

  balance      Float                     @default(0)
  creditLimit  Float                     @default(0)

  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  transactions CurrentAccountTransaction[]
}

model CurrentAccountTransaction {
  id               String          @id @default(cuid())
  accountId        String
  account          CurrentAccount  @relation(fields: [accountId], references: [id])

  type             TransactionType
  amount           Float
  balance          Float
  description      String
  referenceType    String?
  referenceId      String?

  createdAt        DateTime        @default(now())
}

// Bildirimler (Notifications)
model Notification {
  id          String           @id @default(cuid())
  dealerId    String
  dealer      Dealer           @relation(fields: [dealerId], references: [id])

  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  link        String?

  createdAt   DateTime         @default(now())
}

// Teknik Özellikler (Technical Specifications)
model TechnicalSpecification {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  key         String
  value       String
  unit        String?
  category    String?
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, key])
}
